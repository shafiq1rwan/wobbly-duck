    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
